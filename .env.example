APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./data/eventlens.db
DEFAULT_MARKET_TIMEZONE=America/New_York
MARKET_DATA_PROVIDER=yfinance
# Recommended: merged = Finnhub (free company-news with from/to dates, covers the whole
# chart window) + Yahoo (freshest headlines), de-duplicated.
# Alternatives: finnhub | yfinance | alpaca | fixture
NEWS_PROVIDER=merged
REALTIME_PROVIDER=yfinance
# Default true when live market/news APIs are unreachable (e.g. some networks in CN).
# Set false + FINNHUB_API_KEY for live news.
FIXTURE_MODE=true
# Free key: https://finnhub.io/dashboard
FINNHUB_API_KEY=
# If VPN is Clash/V2Ray "system proxy" mode, set this so Python can reach Yahoo:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
YFINANCE_CACHE_DIR=./data/yfinance-cache
YFINANCE_REQUEST_TIMEOUT=20
YFINANCE_BATCH_SIZE=30
YFINANCE_MARKET_REFRESH_SECONDS=30
YFINANCE_QUOTE_REFRESH_SECONDS=5
YFINANCE_NEWS_REFRESH_SECONDS=300
YFINANCE_ENABLE_WEBSOCKET=true
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex
LLM_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT_SECONDS=30
INITIAL_CASH=100000
