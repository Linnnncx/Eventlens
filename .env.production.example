APP_ENV=production
FRONTEND_ORIGIN=http://YOUR_SERVER_IP
DATABASE_URL=sqlite:///./data/eventlens.db
DEFAULT_MARKET_TIMEZONE=America/New_York

# yfinance works without a key but can be delayed or rate-limited. To use
# Alpaca IEX data, change both MARKET_DATA_PROVIDER and REALTIME_PROVIDER to alpaca.
MARKET_DATA_PROVIDER=yfinance
REALTIME_PROVIDER=yfinance
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# merged combines Google News, Yahoo and Finnhub when FINNHUB_API_KEY is set.
NEWS_PROVIDER=merged
FINNHUB_API_KEY=
FIXTURE_MODE=false

# Do not copy a local 127.0.0.1 proxy to the server. Only set these when the
# server itself has a working proxy endpoint.
HTTP_PROXY=
HTTPS_PROXY=

YFINANCE_CACHE_DIR=./data/yfinance-cache
YFINANCE_REQUEST_TIMEOUT=20
YFINANCE_BATCH_SIZE=30
YFINANCE_MARKET_REFRESH_SECONDS=30
YFINANCE_QUOTE_REFRESH_SECONDS=5
YFINANCE_NEWS_REFRESH_SECONDS=300
YFINANCE_ENABLE_WEBSOCKET=true

# Production news prewarmer: explicit symbols, then the user's watchlist, then
# core-universe symbols are de-duplicated and capped at MAX_SYMBOLS.
NEWS_SCHEDULER_INTERVAL_SECONDS=900
NEWS_SCHEDULER_LOOKBACK_DAYS=7
NEWS_SCHEDULER_LIMIT=120
NEWS_SCHEDULER_MAX_SYMBOLS=10
NEWS_SCHEDULER_CONCURRENCY=2
NEWS_SCHEDULER_SYMBOLS=AAPL,NVDA,TSLA,MSFT,META

# Warm real 1Day Yahoo candles for the full local universe every 6 hours.
MARKET_SCHEDULER_INTERVAL_SECONDS=21600
MARKET_SCHEDULER_CONCURRENCY=4
MARKET_SCHEDULER_MAX_SYMBOLS=500

LLM_PROVIDER=rules
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=false
DEEPSEEK_TIMEOUT_SECONDS=30
INITIAL_CASH=100000
